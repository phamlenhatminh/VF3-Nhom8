// ==========================================
// LOP QUAN LY VF3
// ==========================================
class QuanLyXeVF3 {
private:
    vector<VF3> danhSach;

    // Tim xe theo ma
    int timXe(string ma) {
        int i;

        for(i = 0; i < danhSach.size(); i++) {
            if(danhSach[i].getMaXe() == ma)
                return i;
        }

        return -1;
    }

public:
    // Them xe
    void themXe() {
        string ma, mau;
        double gia;

        cout << "\nNhap ma xe: ";
        cin >> ma;

        if(timXe(ma) != -1) {
            cout << "Ma xe da ton tai!" << endl;
            return;
        }

        cout << "Nhap mau sac: ";
        cin >> mau;

        cout << "Nhap gia ban (VND): ";
        cin >> gia;

        if(cin.fail()) {
            cin.clear();
            cin.ignore(1000, '\n');
            cout << "Gia ban khong hop le!" << endl;
            return;
        }

        if(gia <= 0) {
            cout << "Gia ban phai lon hon 0!" << endl;
            return;
        }

        danhSach.push_back(VF3(ma, mau, gia));

        cout << "Them xe thanh cong!" << endl;
    }

    // Hien thi danh sach
    void hienThiDanhSach() {
        if(danhSach.size() == 0) {
            cout << "Danh sach chua co xe!" << endl;
            return;
        }

        int i;

        for(i = 0; i < danhSach.size(); i++) {
            Xe* p = &danhSach[i];
            p->hienThi();
        }
    }

    // Tim kiem
    void timKiemXe() {
        string ma;

        cout << "\nNhap ma xe can tim: ";
        cin >> ma;

        int vt = timXe(ma);

        if(vt == -1) {
            cout << "Khong tim thay xe!" << endl;
        }
        else {
            Xe* p = &danhSach[vt];
            p->hienThi();
        }
    }

    // Sua xe
    void suaXe() {
        string ma, mau;
        double gia;

        cout << "\nNhap ma xe can sua: ";
        cin >> ma;

        int vt = timXe(ma);

        if(vt == -1) {
            cout << "Khong tim thay xe!" << endl;
            return;
        }

        cout << "Nhap mau sac moi: ";
        cin >> mau;

        cout << "Nhap gia ban moi: ";
        cin >> gia;

        if(cin.fail()) {
            cin.clear();
            cin.ignore(1000, '\n');
            cout << "Du lieu khong hop le!" << endl;
            return;
        }

        if(gia <= 0) {
            cout << "Gia ban phai lon hon 0!" << endl;
            return;
        }

        danhSach[vt].setMauSac(mau);
        danhSach[vt].setGiaBan(gia);

        cout << "Sua thong tin thanh cong!" << endl;
    }

    // Xoa xe
    void xoaXe() {
        string ma;

        cout << "\nNhap ma xe can xoa: ";
        cin >> ma;

        int vt = timXe(ma);

        if(vt == -1) {
            cout << "Khong tim thay xe!" << endl;
            return;
        }

        danhSach.erase(danhSach.begin() + vt);

        cout << "Xoa xe thanh cong!" << endl;
    }
};
